# {{title}} settings. Copy to .env (git ignores it) and adjust; every setting in config.py is listed here.

# --- App ---------------------------------------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# one JSON object per log line (on by default in Azure)
LOG_JSON=false
{{#db}}

# --- Database: the local container (scripts/db.sh up). On Azure the deploy sets it. --------------------------------------
DATABASE_URL=postgresql://{{pkg}}:{{pkg}}@localhost:{{pg_port}}/{{pkg}}
{{#azure}}
# sign in with Entra (managed identity on Azure, your az login locally) instead of the password in DATABASE_URL
# DATABASE_ENTRA_AUTH=false
{{/azure}}
{{/db}}
{{#auth}}

# --- Optional: sign-in with WorkOS AuthKit. Empty WORKOS_CLIENT_ID: no sign-in. ------------------------------------------
# In WorkOS: redirect URI <app>/auth/callback, sign-out URI <app>/ (scripts/workos-uris.sh add <app url> sets both),
# sign-in endpoint <app>/auth/login. How long a session lasts is set in the WorkOS dashboard.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# any long random string (openssl rand -base64 32); changing it signs everyone out
SESSION_SECRET=
# only these emails (comma separated) get in, on top of WorkOS's own check
# ALLOWED_USERS=
# the address people use, when a proxy hides it (the callback URL is built from it)
# PUBLIC_URL=
{{/auth}}
